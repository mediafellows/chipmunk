{
  "name": "@mediafellows/chipmunk",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "version": "2.6.2",
  "description": "helper library to talk to mediastore backends",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && webpack --mode production",
    "build:dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "format:check": "prettier --check scripts tests/integration tests/tooling.test.cjs docs CHANGELOG.md playwright.config.cjs",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "testWithCoverage": "nyc mocha --reporter json --reporter-option output=.artifacts/unit-tests.json",
    "test:tooling": "node --test tests/tooling.test.cjs",
    "test:http": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=.artifacts/http-results.xml tests/integration/http.test.cjs",
    "test:browser": "playwright test",
    "test:integration": "yarn build && yarn test:http && yarn test:browser",
    "test:package": "node scripts/package.cjs",
    "audit:deps": "node scripts/audit.cjs",
    "prepack": "yarn build"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "tsconfig.json",
    "CHANGELOG.md",
    "docs"
  ],
  "author": "johannes-kostas goetzinger",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/chai": "5.2.3",
    "@types/chai-as-promised": "8.0.2",
    "@types/lodash": "4.17.25",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.2",
    "@types/querystringify": "2.0.2",
    "@types/sinon": "22.0.0",
    "@types/uri-templates": "0.1.34",
    "chai": "6.2.2",
    "chai-as-promised": "8.0.2",
    "loader-utils": "3.3.1",
    "mocha": "12.0.1",
    "nock": "14.0.17",
    "nyc": "18.0.0",
    "prettier": "3.9.6",
    "sinon": "22.1.0",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "webpack": "5.111.0",
    "webpack-cli": "7.2.3"
  },
  "dependencies": {
    "axios": "1.20.0",
    "lodash": "4.18.1",
    "querystringify": "2.2.0",
    "uri-templates": "0.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@1.22.22",
  "type": "commonjs"
}
